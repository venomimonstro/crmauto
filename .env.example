# Только локальная среда! Скопируйте в .env; НЕ коммитьте пароли.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-me-with-at-least-50-random-characters-before-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DATABASE_URL=postgresql://crmauto:local-only-change-me@db:5432/crmauto
POSTGRES_DB=crmauto
POSTGRES_USER=crmauto
POSTGRES_PASSWORD=local-only-change-me
REDIS_URL=redis://redis:6379/0

# Only for isolated development; do not enable in production.
ENABLE_DEV_REGISTRATION=0

# SaaS writes are enforced by default when DJANGO_DEBUG=0.
# Set to 1 for commercial acceptance testing; provision existing subscriptions first.
BILLING_ENFORCE_WRITES=0

# Email verification and recovery: off until SMTP and trusted origin are configured.
ENABLE_EMAIL_ONBOARDING=0
PUBLIC_WEB_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
SMTP_FROM_EMAIL=
